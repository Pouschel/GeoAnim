{
  "profiles": {
    "serve sample": {
      "commandName": "Project",
      "commandLineArgs": "serve Samples/Euklid/Book1/Prop5.geo",
      "workingDirectory": "$(ProjectDir).."
    },
    "export sample": {
      "commandName": "Project",
      "commandLineArgs": "export Samples/perpendicular-bisector.geo",
      "workingDirectory": "$(ProjectDir).."
    },
    "export dir": {
      "commandName": "Project",
      "commandLineArgs": "exportdir C:/Code/GeoBook/src -o C:/Code/GeoBook/html -assets -serve -sheet",
      "workingDirectory": "$(ProjectDir).."
    },
    "export book": {
      "commandName": "Project",
      "commandLineArgs": "epub C:/Code/GeoBook/src-new -svg -o C:/Code/GeoBook/eb-geo.epub ",
      "workingDirectory": "$(ProjectDir).."
    }
  }
}
