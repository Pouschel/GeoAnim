    "number": {
      "match": "(?<![\\w.])-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)\\b",
      "name": "constant.numeric.geo"
    },
    "math": {
      "match": "(?<!\\\\)\\$[^$]*\\$",
