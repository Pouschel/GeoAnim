    "inline": {
      "patterns": [
        {
          "include": "#math"
        },
        {
          "match": "\\\\[*_`\\[\\]<>\\\\]",
          "name": "constant.character.escape.geo"
        },
        {
          "match": "\\*\\*[^*]+\\*\\*",
          "name": "markup.bold.geo"
        },
        {
          "match": "(?<![\\w*])\\*[^*\\s][^*]*\\*|(?<![\\p{L}\\p{N}])_[^_\\s][^_]*_(?![\\p{L}\\p{N}])",
          "name": "markup.italic.geo"
        },
        {
          "match": "`[^`]*`",
          "name": "markup.inline.raw.geo"
        },
        {
          "match": "\\[[^\\]]*\\]\\([^)\\s]*\\)|<[^>\\s]+\\.[^>\\s]*>",
          "name": "markup.underline.link.geo"
        }
      ]
