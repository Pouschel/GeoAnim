{
  "name": "geoanim-geo",
  "displayName": "GeoAnim (.geo)",
  "description": "GeoAnim scripts (.geo): syntax highlighting, live preview, errors in the editor, tooltips and go to definition; live preview of the pages of a book in Markdown (.geo.md)",
  "version": "0.2.0",
  "publisher": "mathepedia",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configurationDefaults": {
      "[geo]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[geomd]": {
        "editor.wordWrap": "on"
      }
    },
    "languages": [
      {
        "id": "geo",
        "aliases": [
          "GeoAnim",
          "geo"
        ],
        "extensions": [
          ".geo"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/geo-light.svg",
          "dark": "./icons/geo-dark.svg"
        }
      },
      {
        "id": "geomd",
        "aliases": [
          "GeoAnim-Markdown",
          "geomd"
        ],
        "filenamePatterns": [
          "*.geo.md"
        ],
        "configuration": "./language-configuration-geomd.json",
        "icon": {
          "light": "./icons/geomd.svg",
          "dark": "./icons/geomd.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "geo",
        "scopeName": "source.geo",
        "path": "./syntaxes/geo.tmLanguage.json"
      },
      {
        "language": "geomd",
        "scopeName": "text.geomd",
        "path": "./syntaxes/geomd.tmLanguage.json"
      },
      {
        "scopeName": "geomd.math.injection",
        "path": "./syntaxes/geomd-math.tmLanguage.json",
        "injectTo": [
          "text.geomd"
        ]
      }
    ],
    "commands": [
      {
        "command": "geoanim.preview",
        "title": "Vorschau öffnen",
        "category": "GeoAnim",
        "icon": "$(open-preview)"
      },
      {
        "command": "geoanim.restart",
        "title": "Neu starten",
        "category": "GeoAnim"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "geoanim.preview",
          "when": "resourceLangId == geo || resourceLangId == geomd",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "geoanim.preview",
          "when": "editorLangId == geo || editorLangId == geomd"
        }
      ]
    },
    "keybindings": [
      {
        "command": "geoanim.preview",
        "key": "ctrl+k v",
        "when": "editorLangId == geo || editorLangId == geomd"
      }
    ],
    "configuration": {
      "title": "GeoAnim",
      "properties": {
        "geoanim.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Pfad zu `geoanim.exe` (oder `geoanim.dll`) oder zum Ordner des GeoAnim-Repositorys (dann gilt der neuere Build darin). Leer: der neuere Build `GeoAnim/bin/Debug|Release/net10.0` im Arbeitsbereich oder in einem Ordner darüber, auch in einem Ordner `GeoAnim` daneben, sonst `geoanim` aus dem Suchpfad. `${workspaceFolder}` ist erlaubt."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:geo",
    "onLanguage:geomd"
  ]
}
