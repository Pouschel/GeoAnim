<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Formulas in texts: AsciiMath between $…$, turned into SVG paths by MathJax (SVG output, STIX2 font), which runs in
    the JavaScript engine Jint. MathJax and the font data are embedded resources (folders mathjax/ and
    mathjax-stix2-font/).
  -->

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="mathjax\**\*.js" LogicalName="mathjax/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="mathjax-stix2-font\**\*.js" LogicalName="mathjax-stix2-font/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAnim.Tests" />
  </ItemGroup>

</Project>
