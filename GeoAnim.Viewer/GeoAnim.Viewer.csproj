<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The player in the browser (view/: HTML, JavaScript, CSS, fonts) as embedded resources, and the export of an
    animation as one self-contained HTML file.
  -->

  <ItemGroup>
    <EmbeddedResource Include="view\**\*" LogicalName="view/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoAnim.Core\GeoAnim.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAnim.Tests" />
  </ItemGroup>

  <!-- the pages of a book in Markdown (with a YAML block at the start) -->
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
